    },
    "Download verified updates in the background so they are ready to install.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tải các bản cập nhật đã xác minh ở nền để sẵn sàng cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台下载已验证的更新，以便随时安装。"
          }
        }
      }
    },
    "Draw each value as a dot, or join them with a line": {
      "localizations": {
        "vi": {
