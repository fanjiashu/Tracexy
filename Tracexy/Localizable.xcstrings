      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một bản bắt PCAP hoặc PCAPNG, bản bắt nén gzip hoặc một phiên TCP Viewer. Tracexy đọc nội dung tệp, không dựa vào tên."
          }
