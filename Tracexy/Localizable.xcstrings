    },
    "The original file for this Library item changed on this Mac. Locate the original, or reload to read the current file.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp gốc của mục Thư viện này đã thay đổi trên máy Mac. Hãy tìm tệp gốc, hoặc tải lại để đọc tệp hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此抓包库项目的原始文件已在此 Mac 上更改。请定位原始文件，或重新加载以读取当前文件。"
          }
        }
      }
    },
    "The original file for this Library item is no longer available on this Mac. Locate it to open the capture.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp gốc của mục Thư viện này không còn trên máy Mac. Hãy tìm nó để mở bản bắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此抓包库项目的原始文件在此 Mac 上已不可用。请定位文件以打开抓包。"
          }
        }
      }
    },
    "The packet frames for this session are no longer in the local export window.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các khung gói của phiên này không còn trong cửa sổ xuất cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话的数据包帧已不在本地导出窗口中。"
          }
        }
      }
    },
    "The payload type's clock rate is not known, so jitter cannot be measured": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không biết tần số xung nhịp của loại payload nên không đo được jitter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知载荷类型的时钟速率，无法测量抖动"
          }
        }
      }
    },
    "The protocol banner": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Banner giao thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议横幅"
          }
        }
      }
    },
    "The saved capture source is unavailable.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nguồn bản ghi đã lưu không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存抓包源不可用。"
          }
        }
      }
    },
    "The session contains a link type that cannot be represented by pcapng.": {
      "localizations": {
        "vi": {
          "stringUnit": {
