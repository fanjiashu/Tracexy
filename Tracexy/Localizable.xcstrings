          }
        }
      }
    },
    "Choose MaxMind databases to show where each public address is": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn cơ sở dữ liệu MaxMind để hiện vị trí của từng địa chỉ công khai"
          }
        },
        "zh-Hans": {
