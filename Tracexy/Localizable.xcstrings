    "These messages had kinds past the per-session bound, so their kinds were not kept.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những thông điệp này có loại vượt quá giới hạn mỗi phiên, nên loại của chúng không được giữ lại."
          }
