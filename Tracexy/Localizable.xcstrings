      }
    },
    "Update the capture helper in Settings → Helper to use an unoptimized BPF filter.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cập nhật trình trợ giúp bắt gói trong Cài đặt → Trợ giúp để dùng bộ lọc BPF không tối ưu hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置 ▸ 辅助程序”中更新抓包助手，以使用未优化的 BPF 过滤器。"
          }
        }
      }
    },
    "libpcap compiled it to %lld BPF instructions for Ethernet interfaces using optimization. The count can differ if optimization is disabled for the selected interface.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "libpcap đã biên dịch thành %lld lệnh BPF cho giao diện Ethernet khi bật tối ưu hóa. Số lệnh có thể khác nếu tắt tối ưu hóa cho giao diện đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "libpcap 在启用优化时将其编译为 %lld 条以太网接口 BPF 指令。所选接口禁用优化时，指令数可能不同。"
          }
