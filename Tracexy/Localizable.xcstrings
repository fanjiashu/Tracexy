    "Choose MaxMind database files (.mmdb), such as GeoLite2 City, Country or ASN, or DB-IP files in the same format.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn tệp cơ sở dữ liệu MaxMind (.mmdb), như GeoLite2 City, Country hoặc ASN, hoặc tệp DB-IP cùng định dạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
