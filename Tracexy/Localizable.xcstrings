    "Write $name, $name(a, b) or ${name:a;b} in a Session Expression. $1 to $9 in a macro take the values in order.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viết $name, $name(a, b) hoặc ${name:a;b} trong một Session Expression. $1 đến $9 trong macro nhận các giá trị theo thứ tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在会话表达式中使用 $name、$name(a, b) 或 ${name:a;b}。宏参数依次对应 $1 到 $9。"
          }
        }
      }
    },
    "Write Group//Label to put the button in a pull-down named Group.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viết Nhóm//Nhãn để đặt nút vào menu thả xuống tên Nhóm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
