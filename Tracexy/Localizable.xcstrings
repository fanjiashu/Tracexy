            "value": "写 Group//Label 可将按钮放入名为 Group 的下拉菜单。"
          }
        }
      }
    },
    "Write a note about one of the findings on this session": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viết ghi chú về một phát hiện của phiên này"
          }
        },
        "zh-Hans": {
